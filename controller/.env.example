# Copy this file to controller/.env and fill in your own values.
# controller/.env is git-ignored — never commit real tokens/keys.

# Discord bot integration (optional — only needed if you run controller/discord_bot.py)
DISCORD_BOT_TOKEN=
FAIRY_DISCORD_OWNER_ID=
FAIRY_DISCORD_ALLOW_ALL=0

# Route Fairy's reasoning through the local Hermes bridge instead of calling
# a model directly. See hermes_bridge.py.
FAIRY_USE_HERMES=1

# Cloud model fallbacks (optional — only needed if you use these providers
# instead of / alongside local Ollama models)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
